# Optional environment overrides. Normal setup uses config.toml + config.local.toml.
# Uncomment only the values you intend to override.
# DEEPSEEK_API_KEY=your-deepseek-key
# MODEL_API_BASE=https://api.deepseek.com
# MODEL_NAME=deepseek-flash
# MODEL_API_KEY is also supported; DEEPSEEK_API_KEY takes precedence.
# DATA_DIR defaults to ./data
